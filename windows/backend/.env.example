# Copia este archivo a .env y rellena la key. El .env NO se commitea.
#
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Proveedor del boceto:
#   local     -> modelo en la PC de la cabina (sin internet, sin costo por visita)
#   openrouter-> modelo remoto
#   auto      -> intenta local y cae a openrouter si falla o se pasa de tiempo
SKETCH_PROVIDER=auto

# Modelos de imagen que se usan en cada caso (ids de OpenRouter).
OPENROUTER_SKETCH_MODEL=google/gemini-nano-banana-2.1
OPENROUTER_SKETCH_FALLBACK=openai/gpt-image-2

# Presupuesto de la ruta critica: si el proveedor tarda mas, se cae al respaldo.
SKETCH_TIMEOUT_S=25
