# Copia este archivo a .env y rellena la key. El .env NO se commitea.
#
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Proveedor del boceto:
#   local     -> modelo en la PC de la cabina (sin internet, sin costo por visita)
#   openrouter-> modelo remoto
#   auto      -> intenta local y cae a openrouter si falla o se pasa de tiempo
SKETCH_PROVIDER=auto

# Modelos de imagen que se usan en cada caso (ids de OpenRouter).
OPENROUTER_SKETCH_MODEL=google/gemini-nano-banana-2.1
OPENROUTER_SKETCH_FALLBACK=google/gemini-3-pro-image

# Presupuesto de la ruta critica: si el proveedor tarda mas, se cae al respaldo.
SKETCH_TIMEOUT_S=25

# Robot. mock no mueve el brazo. mg400 usa el enlace TCP.
# ROBOT_DRY_RUN=1 arma los MovL y no abre el socket.
# ROBOT_Z_DRAW y ROBOT_Z_TRAVEL salen de joggear el marcador y leer la pose.
ROBOT_BACKEND=mock
ROBOT_HOST=192.168.10.55
ROBOT_DRY_RUN=1
ROBOT_USER=0
ROBOT_TOOL=0
ROBOT_Z_DRAW=
ROBOT_Z_TRAVEL=
ROBOT_R=0
ROBOT_SPEED_FACTOR=20
ROBOT_ORIGIN_X=0
ROBOT_ORIGIN_Y=0
ROBOT_CP_DRAW=0
