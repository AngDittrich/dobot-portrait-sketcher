# Copia este archivo a .env y rellena la key. El .env NO se commitea.
#
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Proveedor del boceto:
#   local     -> modelo en la PC de la cabina (sin internet, sin costo por visita)
#   openrouter-> modelo remoto
#   auto      -> intenta local y cae a openrouter si falla o se pasa de tiempo
SKETCH_PROVIDER=auto

# Modelos de imagen que se usan en cada caso (ids de OpenRouter).
OPENROUTER_SKETCH_MODEL=google/gemini-nano-banana-2.1
OPENROUTER_SKETCH_FALLBACK=openai/gpt-image-2

# Presupuesto de la ruta critica: si el proveedor tarda mas, se cae al respaldo.
SKETCH_TIMEOUT_S=25

# Robot. mock no mueve el brazo. mg400 usa el enlace TCP.
# Estos valores solo arman el primer arranque. Al guardar desde el panel
# admin quedan en data/robot.json y esa calibración es la que usa el robot.
# ROBOT_DRY_RUN=1 arma los MovL y no abre el socket.
# ROBOT_Z_DRAW y ROBOT_Z_TRAVEL salen de joggear el marcador y leer la pose.
# ROBOT_ORIGIN_X y ROBOT_ORIGIN_Y son el CENTRO de la hoja; el papel se centra
# ahi y su tamano sale del recorte, que cambia con cada foto. La hoja va
# acostada, con su lado largo de frente al fondo: de frente el brazo solo tiene
# 240 mm utiles (de 199 a 439 mm), asi que el centro va en 319.24 y no en 279.
#
# Medido en la cabina (brazo a z=-95, R=90), no hace falta volver a calcularlo:
#   fondo util (X) ................ 199.24 a 439.24  (240 mm)
#   a lo ancho (Y) ................ -247.20 a 192.80 (440 mm)
#   centro de la hoja ............. 319.24, -27.20
#   A5 acostada (210 x 148) ....... X 214.24 a 424.24 | Y -101.20 a 46.80
#   A6 acostada (148 x 105) ....... X 245.24 a 393.24 | Y  -79.70 a 25.30
#   A4 acostada (297 x 210) ....... no entra: mide 297 y hay 240
# ROBOT_R=90 deja la punta del marcador al frente, a 5-8 cm del centro del tool.
ROBOT_BACKEND=mock
ROBOT_HOST=192.168.10.55
ROBOT_DRY_RUN=1
ROBOT_USER=0
ROBOT_TOOL=0
ROBOT_Z_DRAW=
ROBOT_Z_TRAVEL=
ROBOT_R=90
ROBOT_R_FAR=
ROBOT_FAR_X=
ROBOT_FAR_Y=
ROBOT_SPEED_FACTOR=20
# Centro de la hoja en milimetros del robot, medido (ver el bloque de arriba).
# ROBOT_X_SIGN y ROBOT_Y_SIGN valen -1 si, al recorrer el dibujo
# hacia la derecha y hacia abajo, esa coordenada del robot baja.
ROBOT_ORIGIN_X=319.24
ROBOT_ORIGIN_Y=-27.2
ROBOT_X_SIGN=-1
ROBOT_Y_SIGN=-1
ROBOT_CP_DRAW=100
# Aceleracion de la pluma en mm/s2. El techo del firmware es 100 (mas da
# -40005). Iba igual a SpeedL (20) y por eso el brazo no pasaba de 4 mm/s.
ROBOT_ACC_MM_S2=100
# Paso mínimo entre puntos de un trazo, en mm. Con 1.2 mm eran 1706 órdenes y
# el controlador cortaba la conexión; con 6 mm quedan ~850 y el brazo acelera.
ROBOT_STEP_MM=8
# Ordenes de dibujo en vuelo. Cada MovL cuesta ~0.5 s: con 1 el brazo se para
# en cada punto (7.5 mm/s medidos); con 3 se solapa y sube a 19.6 mm/s.
ROBOT_PIPELINE=3
# Trazos cuyo final queda a menos de estos mm se dibujan sin levantar el lápiz.
# Cada subida obliga a vaciar la cola (~3 s): uniendo trazos el retrato pasó de
# 365 s. 0 desactiva el encadenado.
ROBOT_JOIN_MM=6
# Hoja de papel: a6, a5 o a4. Decide el tamaño del retrato (ancho de la hoja
# menos 8 mm de aire por lado) y el área que se marca con el lápiz arriba.
# A4 no cabe con el centro actual: el codo no llega al borde izquierdo.
ROBOT_SHEET=a5
# Con la cola llena el MG400 retiene la respuesta del MovL hasta tener espacio.
# ROBOT_MOVE_TIMEOUT_S es cuánto se espera antes de darlo por perdido.
ROBOT_MOVE_TIMEOUT_S=60
# INFO imprime cada paso y un avance cada 50 MovL; DEBUG imprime todos.
ROBOT_LOG_LEVEL=INFO
# PIN de 4 dígitos del panel admin de la cabina.
ADMIN_PIN=2026
