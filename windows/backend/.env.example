# Copia este archivo a .env y rellena la key. El .env NO se commitea.
#
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Proveedor del boceto:
#   local     -> modelo en la PC de la cabina (sin internet, sin costo por visita)
#   openrouter-> modelo remoto
#   auto      -> intenta local y cae a openrouter si falla o se pasa de tiempo
SKETCH_PROVIDER=auto

# Modelos de imagen que se usan en cada caso (ids de OpenRouter).
OPENROUTER_SKETCH_MODEL=google/gemini-nano-banana-2.1
OPENROUTER_SKETCH_FALLBACK=openai/gpt-image-2

# Presupuesto de la ruta critica: si el proveedor tarda mas, se cae al respaldo.
SKETCH_TIMEOUT_S=25

# Robot. mock no mueve el brazo. mg400 usa el enlace TCP.
# La hoja se calibra en el panel admin (Configuración): se enseñan tres
# esquinas con el lápiz tocando el papel y se guardan en data/robot.json.
# Desde ese momento el .env solo aporta lo de abajo que el panel no edita.
# ROBOT_DRY_RUN=1 arma los MovL y no abre el socket.
# Medido en la cabina (z=-95, R=90), para no volver a calcularlo:
#   fondo util (X) ................ 199.24 a 439.24  (240 mm)
#   a lo ancho (Y) ................ -247.20 a 192.80 (440 mm)
#   centro de esa banda ........... 319.24, -27.20
# La hoja va horizontal: el lado largo de izquierda a derecha. Con eso A5
# (210 x 148) y A4 (297 x 210) entran. Con el lado largo de frente al fondo
# A4 no entra, porque 297 mm no caben en los 240 de fondo.
# Las esquinas enseñadas en el panel reemplazan el centro y los signos.
ROBOT_BACKEND=mock
ROBOT_HOST=192.168.10.55
ROBOT_DRY_RUN=1
ROBOT_SPEED_FACTOR=20
# Solo antes de enseñar las esquinas: centro de la hoja, alturas y signos.
# Con esquinas guardadas no se usan.
ROBOT_USER=0
ROBOT_TOOL=0
ROBOT_Z_DRAW=
ROBOT_Z_TRAVEL=
ROBOT_R=90
ROBOT_ORIGIN_X=0
ROBOT_ORIGIN_Y=0
ROBOT_X_SIGN=-1
ROBOT_Y_SIGN=-1
ROBOT_CP_DRAW=100
# Aceleracion de la pluma en mm/s2. El techo del firmware es 100 (mas da
# -40005). Iba igual a SpeedL (20) y por eso el brazo no pasaba de 4 mm/s.
ROBOT_ACC_MM_S2=100
# Solo descarta puntos prácticamente repetidos. La trayectoria ya llega
# simplificada para conservar ojos, letras y curvas pequeñas.
ROBOT_STEP_MM=0.3
# Ordenes de dibujo en vuelo. Cada MovL cuesta ~0.5 s: con 1 el brazo se para
# en cada punto (7.5 mm/s medidos); con 3 se solapa y sube a 19.6 mm/s.
ROBOT_PIPELINE=3
# Solo encadena trazos que ya se tocan visualmente. Un valor grande dibuja
# conectores indeseados entre letras y rasgos.
ROBOT_JOIN_MM=1
# Con la cola llena el MG400 retiene la respuesta del MovL hasta tener espacio.
# ROBOT_MOVE_TIMEOUT_S es cuánto se espera antes de darlo por perdido.
ROBOT_MOVE_TIMEOUT_S=60
# INFO imprime cada paso y un avance cada 50 MovL; DEBUG imprime todos.
ROBOT_LOG_LEVEL=INFO
# PIN de 4 dígitos del panel admin de la cabina.
ADMIN_PIN=2026
