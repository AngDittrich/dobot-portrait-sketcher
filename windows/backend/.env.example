# Copia este archivo a .env y rellena la key. El .env NO se commitea.
#
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Proveedor del boceto:
#   local     -> modelo en la PC de la cabina (sin internet, sin costo por visita)
#   openrouter-> modelo remoto
#   auto      -> intenta local y cae a openrouter si falla o se pasa de tiempo
SKETCH_PROVIDER=auto

# Modelos de imagen que se usan en cada caso (ids de OpenRouter).
OPENROUTER_SKETCH_MODEL=google/gemini-nano-banana-2.1
OPENROUTER_SKETCH_FALLBACK=openai/gpt-image-2

# Presupuesto de la ruta critica: si el proveedor tarda mas, se cae al respaldo.
SKETCH_TIMEOUT_S=25

# Robot. mock no mueve el brazo. mg400 usa el enlace TCP.
# ROBOT_DRY_RUN=1 arma los MovL y no abre el socket.
# ROBOT_Z_DRAW y ROBOT_Z_TRAVEL salen de joggear el marcador y leer la pose.
ROBOT_BACKEND=mock
ROBOT_HOST=192.168.10.55
ROBOT_DRY_RUN=1
ROBOT_USER=0
ROBOT_TOOL=0
ROBOT_Z_DRAW=
ROBOT_Z_TRAVEL=
ROBOT_R=0
ROBOT_R_FAR=
ROBOT_FAR_X=
ROBOT_FAR_Y=
ROBOT_SPEED_FACTOR=20
# Esquina superior izquierda del papel, en milimetros del robot.
# ROBOT_X_SIGN y ROBOT_Y_SIGN valen -1 si, al recorrer el dibujo
# hacia la derecha y hacia abajo, esa coordenada del robot baja.
ROBOT_ORIGIN_X=0
ROBOT_ORIGIN_Y=0
ROBOT_X_SIGN=-1
ROBOT_Y_SIGN=-1
ROBOT_CP_DRAW=0
# Con la cola llena el MG400 retiene la respuesta del MovL hasta tener espacio.
# ROBOT_MOVE_TIMEOUT_S es cuánto se espera antes de darlo por perdido.
ROBOT_MOVE_TIMEOUT_S=60
# INFO imprime cada paso y un avance cada 50 MovL; DEBUG imprime todos.
ROBOT_LOG_LEVEL=INFO
